{
  "name": "flat-league",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3020",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3020",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "tsx --test tests/postgres.test.ts",
    "db:migrate": "tsx scripts/database.ts",
    "worker": "tsx apps/worker/main.ts",
    "worker:once": "tsx apps/worker/main.ts --once",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "local:deploy": "tsx scripts/local-deploy.ts",
    "testnet:deploy": "tsx scripts/testnet-deploy.ts",
    "local:chain": "tsx scripts/local-chain.ts",
    "local:up": "tsx scripts/local-up.ts",
    "check:ui": "tsx scripts/check-ui.ts",
    "check:ui-polish": "tsx scripts/check-ui-polish.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@next/env": "16.4.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.100.14",
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "@x402/extensions": "^2.29.0",
    "@x402/svm": "^2.29.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "geist": "^1.9.0",
    "gsap": "^3.14.2",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "siwe": "^3.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "viem": "^2.38.0",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
